{
  "manifest_version": 3,
  "name": "Smart Focus Lock",
  "version": "3.1.0",
  "description": "Silent realtime website blocker connected directly to your Focus Lock dashboard.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {},
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
